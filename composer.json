{
  "name": "trionnemesis/php-modern-guidelines",
  "description": "Version-aware Modern PHP Guidelines for coding agents.",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": ["php", "composer", "guidelines", "coding-agents"],
  "require": {
    "composer-runtime-api": "^2.2",
    "php": ">=8.2",
    "symfony/console": "^6.4 || ^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^1.12 || ^2.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "ModernPhpGuidelines\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ModernPhpGuidelines\\Tests\\": "tests/"
    }
  },
  "bin": ["bin/php-modern-guidelines"],
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=1G",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "check": ["@test", "@stan", "@lint"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
