{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/php-modern-guidelines/schemas/rule.schema.json",
  "title": "Modern PHP Guideline rule",
  "description": "Contract for a source-backed PHP language, Core, or bundled-extension guideline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "summary", "category", "kind", "priority", "introduced_in", "deprecated_in", "removed_in", "extension", "package_constraints", "behavior_change_risk", "new_code_policy", "existing_code_policy", "guideline", "details", "examples", "verification", "sources", "notes"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["language", "core", "extension"]},
    "kind": {"type": "string", "enum": ["feature", "modern_preference", "deprecated", "removed", "compatibility_guard", "behavior_change"]},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "introduced_in": {"$ref": "#/$defs/phpMinorOrNull"},
    "deprecated_in": {"$ref": "#/$defs/phpMinorOrNull"},
    "removed_in": {"$ref": "#/$defs/phpMinorOrNull"},
    "extension": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*$"},
    "package_constraints": {"type": "object", "additionalProperties": {"type": "string"}},
    "behavior_change_risk": {"type": "string", "enum": ["none", "low", "medium", "high"]},
    "new_code_policy": {"type": "string", "minLength": 1},
    "existing_code_policy": {"type": "string", "minLength": 1},
    "guideline": {"type": "string", "minLength": 1},
    "details": {"type": "string", "minLength": 1},
    "examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/example"}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["phpcompatibility", "phpstan", "rector"], "properties": {"phpcompatibility": {"description": "Sorted, unique PHPCompatibility sniff identifiers; an empty list means no proven mapping.", "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "phpstan": {"type": ["string", "null"]}, "rector": {"type": ["string", "null"]}}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "superseded_by": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "feature"}}}, "then": {"properties": {"introduced_in": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}}}},
    {"if": {"properties": {"kind": {"const": "deprecated"}}}, "then": {"properties": {"deprecated_in": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}}}},
    {"if": {"properties": {"kind": {"const": "removed"}}}, "then": {"properties": {"removed_in": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}}}},
    {"if": {"properties": {"category": {"const": "extension"}}}, "then": {"properties": {"extension": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}}}}
  ],
  "$defs": {
    "phpMinorOrNull": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"},
    "example": {"type": "object", "additionalProperties": false, "properties": {"before": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "after": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "no_automatic_replacement": {"type": "boolean"}}, "oneOf": [{"required": ["before", "after"], "not": {"required": ["no_automatic_replacement"]}}, {"required": ["no_automatic_replacement"], "properties": {"no_automatic_replacement": {"const": true}}, "not": {"anyOf": [{"required": ["before"]}, {"required": ["after"]}]}}]},
    "source": {"type": "object", "additionalProperties": false, "required": ["type", "url", "checked_at"], "properties": {"type": {"type": "string", "enum": ["official_php_migration_guide", "official_php_manual", "official_php_rfc", "php_source_upgrading"]}, "url": {"type": "string", "format": "uri", "pattern": "^https://(?:www\\.php\\.net/|wiki\\.php\\.net/|github\\.com/php/php-src/|raw\\.githubusercontent\\.com/php/php-src/)"}, "checked_at": {"type": "string", "format": "date"}}}
  }
}
